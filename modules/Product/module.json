{
    "name": "Product",
    "alias": "product",
    "description": "Products, variants, media associations and publish lifecycle",
    "version": "1.0.0",
    "priority": 20,
    "providers": [
        "Commerce\\Product\\ProductServiceProvider"
    ],
    "dependencies": {
        "hard": [],
        "soft": [
            "iam",
            "catalog",
            "media",
            "settings"
        ]
    },
    "permissions": [
        "product.product.view",
        "product.product.create",
        "product.product.update",
        "product.product.delete",
        "product.product.publish"
    ],
    "settings": [
        {
            "key": "product.fallback_image_media_uuid",
            "type": "string",
            "label": "Fallback product image",
            "group": "product",
            "input": "media",
            "help": "Shown when a product has no images assigned.",
            "default": null,
            "validation": ["nullable", "uuid"]
        },
        {
            "key": "product.sku_pattern",
            "type": "string",
            "label": "Default SKU pattern",
            "group": "product",
            "input": "text",
            "help": "Tokens: {PRODUCT}, {COLOR}, {SIZE}, and option names in braces.",
            "default": "{PRODUCT}-{COLOR}-{SIZE}",
            "validation": ["nullable", "string", "max:255"]
        }
    ],
    "admin_menu": {
        "label": "Products",
        "icon": "cube",
        "route": "admin.products.index",
        "order": 25,
        "permission": "product.product.view"
    }
}
