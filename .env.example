APP_NAME="Commerce Framework"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:1234

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8890
DB_DATABASE=commerce_framework
DB_USERNAME=root
DB_PASSWORD=root

DATABASE_URL="mysql://root:root@127.0.0.1:8890/commerce_framework"

IAM_DEFAULT_ADMIN_EMAIL=superadmin@example.com
IAM_DEFAULT_ADMIN_PASSWORD=password
IAM_TWO_FACTOR_ENABLED=false
IAM_TWO_FACTOR_REQUIRED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

PAYMENT_GATEWAY=simulated
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

COMMERCE_TENANT_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@commerce.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

MEDIA_DISK=public
MEDIA_KEEP_ORIGINAL=true
